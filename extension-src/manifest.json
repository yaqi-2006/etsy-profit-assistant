{
  "manifest_version": 3,
  "name": "Etsy Profit Assistant - Offline Local Analyzer",
  "short_name": "EtsyProfit",
  "version": "0.1.0",
  "description": "Offline local profit and fee analyzer for Etsy sellers. Runs in-memory; no network access, no account sync, no persistent financial storage.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Etsy Profit Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none';"
  }
}
